# ============================================================
#  SMART FARMING AI AGENT — Environment Configuration
#  IBM Cloud Lite / IBM Granite (watsonx.ai)
# ============================================================

# ----------------------------------------------------------
# IBM watsonx.ai  (Required — IBM Cloud Lite account)
# Get these from: https://cloud.ibm.com/  ->  watsonx.ai
# ----------------------------------------------------------
WATSONX_API_KEY=DNlmzQfM1rTtRUqpkn3f4hXYxFXh_2MuOD-yEAePft2U
WATSONX_URL=https://au-syd.ml.cloud.ibm.com
WATSONX_PROJECT_ID=ed3515ba-4b5c-412d-91e3-b113efb6fec8

# IBM Granite Model (Lite-tier supported models)
GRANITE_MODEL_ID=meta-llama/llama-3-3-70b-instruct
# Alternative models:
#   ibm/granite-3-8b-instruct
#   ibm/granite-13b-instruct-v2
#   ibm/granite-20b-multilingual

# ----------------------------------------------------------
# IBM Watson Discovery  (Optional)
# ----------------------------------------------------------
WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
WATSON_DISCOVERY_INSTANCE_ID=your_discovery_instance_id_here
WATSON_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# ----------------------------------------------------------
# IBM Cloud Object Storage  (Optional)
# ----------------------------------------------------------
COS_API_KEY=your_cos_api_key_here
COS_INSTANCE_CRN=your_cos_instance_crn_here
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET_NAME=farming-agent-kb

# ----------------------------------------------------------
# Weather API  (Open-Meteo - FREE, no key required)
# ----------------------------------------------------------
WEATHER_API_PROVIDER=open_meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ----------------------------------------------------------
# Mandi / Market Price API (data.gov.in)
# ----------------------------------------------------------
AGMARKNET_API_KEY=your_agmarknet_api_key_here
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
APP_NAME=Smart Farming AI Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------------------------------------
# RAG / Vector Store Settings
# ----------------------------------------------------------
VECTOR_DB_PATH=./data/vectorstore
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----------------------------------------------------------
# LLM Generation Parameters
# ----------------------------------------------------------
LLM_MAX_NEW_TOKENS=400
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.95
LLM_TOP_K=50
LLM_REPETITION_PENALTY=1.1

# ----------------------------------------------------------
# Multi-language Settings
# ----------------------------------------------------------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,pa,te,ta,kn,mr,bn,gu,or
AUTO_DETECT_LANGUAGE=true

# ----------------------------------------------------------
# CORS / Security
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECRET_KEY=change_this_to_a_random_secret_key_in_production
